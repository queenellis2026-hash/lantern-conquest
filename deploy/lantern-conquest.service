[Unit]
Description=Lantern Conquest game server
After=network.target

[Service]
Type=simple
User=ellis
WorkingDirectory=/home/ellis/lantern-conquest
ExecStart=/usr/bin/python3 /home/ellis/lantern-conquest/server.py --port 8898 --host 127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
